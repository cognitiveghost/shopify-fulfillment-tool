+
+/* --- Reports (phase 9 spec section 6.8) ----------------------------------- */
+
+.report-match { color: var(--text-secondary); }
+.report-match.warn { color: var(--status-warning); }
+.report-filename { width: 260px; }
+.report-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+
+/* --- Tag categories (phase 9 spec section 7.7) ---------------------------- */
