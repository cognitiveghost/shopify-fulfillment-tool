--- /dev/null
+++ b/gui/settings/tags_state.py
@@ -0,0 +1,470 @@
+"""The values behind the Tag categories page (phase 9 spec section 7).
+
+A tag category is a named group of internal tags; a tag belongs to one.
+TagsDraft holds config_data["tag_categories"], takes the page's edits through
+apply(), and words everything the page draws. A category's colour, its order
+number and its ID are stored and never drawn. No Qt import.
+"""
+
+import re
+
+from gui.settings.contract import PageContract
+from gui.settings.page_state import _shaped
+from shopify_tool.tag_manager import validate_tag_categories_v2
+
+# A category's colour is data, not a theme value. Nothing draws it today; the
+# validator still requires the key, so a new category gets this one.
+DEFAULT_TAG_COLOR = "#9E9E9E"  # style-lint: allow
+MIN_QUANTITY = 0.01
+MAX_QUANTITY = 999.99
+LAST = 999
+
+SUBTITLE = "The internal tags an order can carry, in groups. A tag belongs to one category."
+ADD_CATEGORY = "Add category"
+NEW_CATEGORY = "New category"
+UNNAMED = "Unnamed category"
+EMPTY_TITLE = "No tag categories yet"
+EMPTY_TEXT = "Tags mark orders for packing and for reports. Group them into categories here."
+NO_TAGS = "No tags yet."
+TAG_PLACEHOLDER = "Add tag"
+TAG_HINT = "Press Enter to add. Tags are stored in capitals."
+WRITEOFF_LABEL = "Packaging write-off"
+WRITEOFF_BADGE = "Write-off"
+WRITEOFF_HINT = (
+    "A stock export can write off the SKUs below for each order that carries the tag."
+)
+ADD_TAG_FIRST = "Add a tag first."
+
+NO_NAME = "Type the category's name."
+NO_WRITEOFF_SKU = "Type the SKU to write off."
+QUANTITY_PROBLEM = f"Type a number from {MIN_QUANTITY} to {MAX_QUANTITY}."
+
+_KEY_UID = re.compile(r"cat-(\d+)-")
+_NOT_ID = re.compile(r"[^a-z0-9]+")
+
+
+def _text(value) -> str:
+    return "" if value is None else str(value)
+
+
+def _plural(count: int, one: str, many: str) -> str:
+    return f"{count} {one if count == 1 else many}"
+
+
+def _quantity_text(value) -> str:
+    try:
+        return f"{float(value):g}"
+    except (TypeError, ValueError):
+        return _text(value)
+
+
+def _quantity(text: str) -> float | None:
+    """A write-off quantity, or None when it is not a number in range."""
+    try:
+        number = float(text.strip().replace(",", "."))
+    except ValueError:
+        return None
+    return number if MIN_QUANTITY <= number <= MAX_QUANTITY else None
+
+
+def _order(category: dict):
+    order = category.get("order", LAST)
+    return order if isinstance(order, (int, float)) and not isinstance(order, bool) else LAST
+
+
+def _mappings(category: dict) -> list[dict]:
+    """The stored write-offs as rows. A malformed entry is dropped."""
+    writeoff = category.get("sku_writeoff")
+    stored = writeoff.get("mappings") if isinstance(writeoff, dict) else None
+    rows = []
+    for tag, items in (stored if isinstance(stored, dict) else {}).items():
+        for item in items if isinstance(items, list) else []:
+            if isinstance(item, dict) and "sku" in item and "quantity" in item:
+                rows.append(
+                    {
+                        "tag": _text(tag),
+                        "sku": _text(item["sku"]),
+                        "quantity": _quantity_text(item["quantity"]),
+                        "stored": dict(item),
+                    }
+                )
+    return rows
+
+
+class TagsDraft(PageContract):
+    """Tag categories, stored under config_data["tag_categories"] (v2)."""
+
+    def __init__(self, tag_categories: dict):
+        # The live dict: collect() writes into it in place (PageContract).
+        self._live = tag_categories
+        # With no "version" the dict is the categories themselves (v1).
+        self._v2 = "version" in tag_categories
+        raw = tag_categories.get("categories") if self._v2 else tag_categories
+        stored = [
+            (category_id, category)
+            for category_id, category in (raw if isinstance(raw, dict) else {}).items()
+            if isinstance(category, dict)
+        ]
+        stored.sort(key=lambda item: _order(item[1]))
+        self._next = 0
+        self.open_uid: str | None = None
+        self.entries = [self._entry(category_id, category) for category_id, category in stored]
+
+    def _uid(self) -> str:
+        self._next += 1
+        return str(self._next)
+
+    def _entry(self, category_id, category: dict) -> dict:
+        tags = category.get("tags")
+        writeoff = category.get("sku_writeoff")
+        return {
+            "uid": self._uid(),
+            # None until the first save fixes it: a new category's ID follows
+            # its name.
+            "id": None if category_id is None else _text(category_id),
+            "label": _text(category.get("label", category_id)),
+            "tags": [_text(tag) for tag in tags] if isinstance(tags, list) else [],
+            "writeoff": bool(writeoff.get("enabled")) if isinstance(writeoff, dict) else False,
+            "mappings": _mappings(category),
+            "stored": dict(category),
+            "tag_problem": "",
+        }
+
+    def _find(self, uid: str) -> dict | None:
+        return next((e for e in self.entries if e["uid"] == uid), None)
+
+    @staticmethod
+    def _name(entry: dict) -> str:
+        return entry["label"].strip() or UNNAMED
+
+    # --- the edits ---------------------------------------------------------
+
+    def apply(self, action: str, args) -> bool:
+        entry = None
+        if isinstance(args, list) and args and type(args[0]) is str:
+            entry = self._find(args[0])
+        # A refused tag's sentence stands until the next edit to its category.
+        # Opening the row is not an edit.
+        stale = (
+            entry is not None
+            and action not in ("tag_add", "open")
+            and bool(entry["tag_problem"])
+        )
+        if stale:
+            entry["tag_problem"] = ""
+        return self._apply(action, args, entry) or stale
+
+    def _apply(self, action: str, args, entry: dict | None) -> bool:
+        if action == "close" and _shaped(args):
+            if self.open_uid is None:
+                return False
+            self.open_uid = None
+            return True
+        if action == "reveal" and _shaped(args, str):
+            found = _KEY_UID.match(args[0])
+            return bool(found) and self.apply("open", [found.group(1)])
+        if action == "cat_add" and _shaped(args):
+            new = self._entry(None, {"label": NEW_CATEGORY})
+            new["stored"] = {}
+            self.entries.append(new)
+            self.open_uid = new["uid"]
+            return True
+        if entry is None:
+            return False
+        if action == "open" and _shaped(args, str):
+            if self.open_uid == entry["uid"]:
+                return False
+            self.open_uid = entry["uid"]
+            return True
+        if action == "cat_delete" and _shaped(args, str):
+            self.entries.remove(entry)
+            if self.open_uid == entry["uid"]:
+                self.open_uid = None
+            return True
+        if action == "cat_move" and _shaped(args, str, str):
+            if args[1] not in ("up", "down"):
+                return False
+            at = self.entries.index(entry)
+            to = at + (-1 if args[1] == "up" else 1)
+            if not 0 <= to < len(self.entries):
+                return False
+            self.entries[at], self.entries[to] = self.entries[to], self.entries[at]
+            return True
+        if action == "cat_label" and _shaped(args, str, str):
+            if entry["label"] == args[1]:
+                return False
+            entry["label"] = args[1]
+            return True
+        if action == "tag_add" and _shaped(args, str, str):
+            return self._add_tag(entry, args[1])
+        if action == "tag_remove" and _shaped(args, str, str):
+            if args[1] not in entry["tags"]:
+                return False
+            entry["tags"].remove(args[1])
+            # Its write-offs go with it: they would deduct for a tag the
+            # category no longer has.
+            entry["mappings"] = [m for m in entry["mappings"] if m["tag"] != args[1]]
+            return True
+        if action == "writeoff" and _shaped(args, str, bool):
+            if entry["writeoff"] == args[1]:
+                return False
+            entry["writeoff"] = args[1]
+            return True
+        if action == "map_add" and _shaped(args, str):
+            if not entry["tags"]:
+                return False
+            entry["mappings"].append(
+                {"tag": entry["tags"][0], "sku": "", "quantity": "1", "stored": {}}
+            )
+            return True
+        if action == "map_remove" and _shaped(args, str, str):
+            at = self._mapping_at(entry, args[1])
+            if at is None:
+                return False
+            del entry["mappings"][at]
+            return True
+        if action in ("map_tag", "map_sku", "map_quantity") and _shaped(args, str, str, str):
+            at = self._mapping_at(entry, args[1])
+            name = action.removeprefix("map_")
+            if at is None or entry["mappings"][at][name] == args[2]:
+                return False
+            if name == "tag" and args[2] not in entry["tags"]:
+                return False
+            entry["mappings"][at][name] = args[2]
+            return True
+        return False
+
+    @staticmethod
+    def _mapping_at(entry: dict, position: str) -> int | None:
+        if not position.isdecimal() or int(position) >= len(entry["mappings"]):
+            return None
+        return int(position)
+
+    def _add_tag(self, entry: dict, text: str) -> bool:
+        """Add a tag, or refuse it with a sentence. True when the page has
+        something new to draw."""
+        had = bool(entry["tag_problem"])
+        entry["tag_problem"] = ""
+        tag = text.strip().upper()
+        if not tag:
+            return had
+        if tag in entry["tags"]:
+            entry["tag_problem"] = f"{tag} is already in this category."
+            return True
+        other = next((e for e in self.entries if e is not entry and tag in e["tags"]), None)
+        if other is not None:
+            entry["tag_problem"] = (
+                f"{tag} is already in {self._name(other)}. A tag belongs to one category."
+            )
+            return True
+        entry["tags"].append(tag)
+        return True
+
+    # --- what blocks a save ------------------------------------------------
+
+    def _problems(self, entry: dict) -> list[tuple[str, str]]:
+        """(sentence, data-key) for each thing on this category that blocks a
+        save."""
+        key = f"cat-{entry['uid']}"
+        found = []
+        if not entry["label"].strip():
+            found.append((NO_NAME, f"{key}-label"))
+        earlier = self.entries[: self.entries.index(entry)]
+        for tag in entry["tags"]:
+            owner = next((e for e in earlier if tag in e["tags"]), None)
+            if owner is not None:
+                found.append(
+                    (
+                        f"{tag} is also in {self._name(owner)}. Remove it from one.",
+                        f"{key}-tag-input",
+                    )
+                )
+        seen = set()
+        for m, mapping in enumerate(entry["mappings"]):
+            sku = mapping["sku"].strip()
+            pair = (mapping["tag"], sku)
+            if not sku:
+                found.append((NO_WRITEOFF_SKU, f"{key}-m{m}-sku"))
+            elif _quantity(mapping["quantity"]) is None:
+                found.append((QUANTITY_PROBLEM, f"{key}-m{m}-quantity"))
+            elif pair in seen:
+                found.append((f"{sku} is mapped to {mapping['tag']} twice.", f"{key}-m{m}-sku"))
+            seen.add(pair)
+        return found
+
+    def _blocking(self) -> list[tuple[int, dict, list[tuple[str, str]]]]:
+        return [
+            (place, entry, problems)
+            for place, entry in enumerate(self.entries, 1)
+            if (problems := self._problems(entry))
+        ]
+
+    def blocker(self) -> str | None:
+        blocking = self._blocking()
+        if not blocking:
+            return None
+        place, entry, _problems = blocking[0]
+        if not entry["label"].strip():
+            return f"Name category {place}"
+        return f"Fix category “{entry['label'].strip()}”"
+
+    def blocker_key(self) -> str:
+        blocking = self._blocking()
+        return blocking[0][2][0][1] if blocking else ""
+
+    def validate(self) -> tuple[bool, list[str]]:
+        lines = [
+            f"Category “{self._name(entry)}”: {sentence}"
+            for _place, entry, problems in self._blocking()
+            for sentence, _key in problems
+        ]
+        if lines:
+            return False, lines
+        # Whatever this page does not check itself.
+        return validate_tag_categories_v2({"version": 2, "categories": self.stored()})
+
+    # --- what is saved -----------------------------------------------------
+
+    @staticmethod
+    def _new_id(entry: dict, taken: set[str]) -> str:
+        """An ID for a category that has none yet, made from its name."""
+        base = _NOT_ID.sub("_", entry["label"].lower()).strip("_") or "category"
+        candidate, n = base, 2
+        while candidate in taken:
+            candidate, n = f"{base}_{n}", n + 1
+        return candidate
+
+    def _ids(self) -> list[str]:
+        """Each category's ID, in list order: its own, or one made from its
+        name that no other category has."""
+        taken = {entry["id"] for entry in self.entries if entry["id"] is not None}
+        ids = []
+        for entry in self.entries:
+            category_id = entry["id"]
+            if category_id is None:
+                category_id = self._new_id(entry, taken)
+                taken.add(category_id)
+            ids.append(category_id)
+        return ids
+
+    def stored(self) -> dict:
+        """The categories as stored, in list order."""
+        categories = {}
+        for place, (category_id, entry) in enumerate(
+            zip(self._ids(), self.entries, strict=True), 1
+        ):
+            category = {
+                **entry["stored"],
+                "label": entry["label"],
+                "color": entry["stored"].get("color") or DEFAULT_TAG_COLOR,
+                "order": place,
+                "tags": list(entry["tags"]),
+            }
+            had = entry["stored"].get("sku_writeoff")
+            if isinstance(had, dict) or entry["writeoff"] or entry["mappings"]:
+                mappings: dict[str, list] = {}
+                for mapping in entry["mappings"]:
+                    quantity = _quantity(mapping["quantity"])
+                    mappings.setdefault(mapping["tag"], []).append(
+                        {
+                            **mapping["stored"],
+                            "sku": mapping["sku"].strip(),
+                            # One that blocks the save is written as typed.
+                            "quantity": mapping["quantity"] if quantity is None else quantity,
+                        }
+                    )
+                category["sku_writeoff"] = {
+                    **(had if isinstance(had, dict) else {}),
+                    "enabled": entry["writeoff"],
+                    "mappings": mappings,
+                }
+            categories[category_id] = category
+        return categories
+
+    def collect(self) -> dict:
+        categories = self.stored()
+        if not self._v2:
+            # The old format's top-level keys were the categories themselves.
+            self._live.clear()
+            self._v2 = True
+        self._live["version"] = 2
+        self._live["categories"] = categories
+        return {"tag_categories": self._live}
+
+    def mark_clean(self, snapshot: str | None = None) -> None:
+        if snapshot is not None:
+            # A save went through: a new category's ID is now in the profile,
+            # and must not follow its name any more.
+            for category_id, entry in zip(self._ids(), self.entries, strict=True):
+                entry["id"] = category_id
+        super().mark_clean(snapshot)
+
+    # --- what the page draws -----------------------------------------------
+
+    def _editor(self, entry: dict, by_key: dict[str, str]) -> dict:
+        key = f"cat-{entry['uid']}"
+        rows = []
+        for m, mapping in enumerate(entry["mappings"]):
+            sku_problem = by_key.get(f"{key}-m{m}-sku", "")
+            quantity_problem = by_key.get(f"{key}-m{m}-quantity", "")
+            rows.append(
+                {
+                    "tag": mapping["tag"],
+                    "sku": mapping["sku"],
+                    "quantity": mapping["quantity"],
+                    "problem": sku_problem or quantity_problem,
+                    "invalid": "sku" if sku_problem else "quantity" if quantity_problem else "",
+                }
+            )
+        return {
+            "label_problem": by_key.get(f"{key}-label", ""),
+            "tags": list(entry["tags"]),
+            "tag_placeholder": TAG_PLACEHOLDER,
+            "tag_problem": entry["tag_problem"] or by_key.get(f"{key}-tag-input", ""),
+            "tag_hint": TAG_HINT,
+            "writeoff": {
+                "on": entry["writeoff"],
+                "label": WRITEOFF_LABEL,
+                "hint": WRITEOFF_HINT,
+                "can_add": bool(entry["tags"]),
+                "add_title": "" if entry["tags"] else ADD_TAG_FIRST,
+                "rows": rows,
+            },
+        }
+
+    def _row(self, entry: dict, place: int) -> dict:
+        problems = self._problems(entry)
+        is_open = entry["uid"] == self.open_uid
+        # The first sentence for a key wins.
+        by_key = {key: sentence for sentence, key in reversed(problems)}
+        return {
+            "uid": entry["uid"],
+            "name": entry["label"],
+            "label": self._name(entry),
+            "open": is_open,
+            "chips": list(entry["tags"]),
+            "no_tags": "" if entry["tags"] else NO_TAGS,
+            "badge": WRITEOFF_BADGE if entry["writeoff"] else "",
+            "can_up": place > 0,
+            "can_down": place < len(self.entries) - 1,
+            "problem": problems[0][0] if problems else "",
+            "editor": self._editor(entry, by_key) if is_open else None,
+        }
+
+    def view(self) -> dict:
+        empty = None
+        if not self.entries:
+            empty = {"title": EMPTY_TITLE, "text": EMPTY_TEXT, "action": ADD_CATEGORY}
+        tags = sum(len(entry["tags"]) for entry in self.entries)
+        return {
+            "page": "tags",
+            "title": "Tag categories",
+            "subtitle": SUBTITLE,
+            "action": ADD_CATEGORY if self.entries else "",
+            "tags": {
+                "empty": empty,
+                "count": f"{_plural(len(self.entries), 'category', 'categories')}, "
+                f"{_plural(tags, 'tag', 'tags')}",
+                "rows": [self._row(entry, place) for place, entry in enumerate(self.entries)],
+            },
+        }
