  "rules": [
    {
      "name": "ORDERCHECK",
      "priority": 1,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "Order_Fulfillment_Status",
              "operator": "equals",
              "value": "Fulfillable"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "O"
            }
          ]
        }
      ]
    },
    {
      "name": "SMALLBAG",
      "priority": 2,
      "level": "order",
      "steps": [
        {
          "conditions": [
            {
              "field": "total_quantity",
              "operator": "is less than or equal",
              "value": "6"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "SMALL_BAG"
            }
          ]
        }
      ]
    },
    {
      "name": "LARGEBAG",
      "priority": 3,
      "level": "order",
      "steps": [
        {
          "conditions": [
            {
              "field": "total_quantity",
              "operator": "is greater than",
              "value": "6"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "LARGE_BAG"
            }
          ]
        }
      ]
    },
    {
      "name": "NO_SKU",
      "priority": 4,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "SKU",
              "operator": "contains",
              "value": "NO_SKU"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ALERT_NOTIFICATION",
              "message": "NOSKU",
              "severity": "error"
            },
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "NOSKU"
            }
          ]
        }
      ]
    }
  ],
