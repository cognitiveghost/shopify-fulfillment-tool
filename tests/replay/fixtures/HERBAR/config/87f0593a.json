  "courier_mappings": {
    "DHL": {
      "patterns": [
        "DHL"
      ],
      "case_sensitive": false
    },
    "POST": {
      "patterns": [
        "7-15",
        "3-9",
        "5-10",
        "4 - 7",
        "FREE",
        "5-8"
      ],
      "case_sensitive": false
    }
  },
  "analysis_mode": "fifo",
  "settings": {
    "low_stock_threshold": 5,
    "stock_csv_delimiter": "auto",
    "orders_csv_delimiter": "auto",
    "repeat_detection_days": 1,
    "delimiter_auto_migrated": true
  },
  "rules": [
    {
      "name": "O",
      "priority": 1,
      "level": "order",
      "steps": [
        {
          "conditions": [
            {
              "field": "Order_Fulfillment_Status",
              "operator": "equals",
              "value": "Fulfillable"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "O"
            },
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "BOX"
            }
          ]
        }
      ]
    },
    {
      "name": "MISSING SKU",
      "priority": 2,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "SKU",
              "operator": "contains",
              "value": "NO_SKU"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "MISSING SKU"
            }
          ]
        }
      ]
    },
    {
      "name": "BG",
      "priority": 3,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "Destination_Country",
              "operator": "contains",
              "value": "BG"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "SPEEDY"
            }
          ]
        }
      ]
    },
    {
      "name": "DHL",
      "priority": 4,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "Destination_Country",
              "operator": "contains",
              "value": "US"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "DHL"
            }
          ]
        }
      ]
    },
    {
      "name": "New Rule",
      "priority": 5,
      "level": "order",
      "steps": [
        {
          "conditions": [
            {
              "field": "total_quantity",
              "operator": "is greater than",
              "value": "10"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "STOKIST"
            },
            {
              "type": "REMOVE_INTERNAL_TAG",
              "value": "O"
            },
            {
              "type": "REMOVE_INTERNAL_TAG",
              "value": "BOX"
            }
          ]
        }
      ]
    }
  ],
  "order_rules": [],
