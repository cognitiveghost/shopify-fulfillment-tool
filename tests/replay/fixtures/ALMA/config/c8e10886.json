  "courier_mappings": {
    "SPEEDY": {
      "patterns": [
        "Спиди"
      ],
      "case_sensitive": false
    },
    "DPD": {
      "patterns": [
        "Dpd"
      ],
      "case_sensitive": false
    },
    "POST": {
      "patterns": [
        "POSTONE"
      ],
      "case_sensitive": false
    }
  },
  "analysis_mode": "fifo",
  "settings": {
    "low_stock_threshold": 5,
    "stock_csv_delimiter": "auto",
    "orders_csv_delimiter": "auto",
    "repeat_detection_days": 1,
    "delimiter_auto_migrated": true
  },
  "rules": [
    {
      "name": "Mask",
      "priority": 1,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "SKU",
              "operator": "matches regex",
              "value": "^02-FACE"
            }
          ],
          "match": "ANY",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "MASK"
            }
          ]
        },
        {
          "conditions": [
            {
              "field": "SKU",
              "operator": "contains",
              "value": "02-FACE-1002"
            },
            {
              "field": "SKU",
              "operator": "contains",
              "value": "02-FACE-1003"
            }
          ],
          "match": "ANY",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "MASK_II"
            },
            {
              "type": "REMOVE_INTERNAL_TAG",
              "value": "MASK"
            }
          ]
        }
      ]
    },
    {
      "name": "Box",
      "priority": 2,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "SKU",
              "operator": "matches regex",
              "value": "^(01|05)"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "BOX"
            }
          ]
        }
      ]
    },
    {
      "name": "International",
      "priority": 3,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "Destination_Country",
              "operator": "does not contain",
              "value": "BG"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "INTERNATIONAL"
            }
          ]
        }
      ]
    },
    {
      "name": "Lux Box",
      "priority": 4,
      "level": "article",
      "steps": [
        {
          "conditions": [
            {
              "field": "Notes",
              "operator": "contains",
              "value": "LUX"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "LUX"
            }
          ]
        }
      ]
    },
    {
      "name": "Large orders",
      "priority": 5,
      "level": "order",
      "steps": [
        {
          "conditions": [
            {
              "field": "total_quantity",
              "operator": "is greater than",
              "value": "13"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "Large"
            }
          ]
        }
      ]
    },
    {
      "name": "o",
      "priority": 6,
      "level": "order",
      "steps": [
        {
          "conditions": [
            {
              "field": "Order_Fulfillment_Status",
              "operator": "equals",
              "value": "Fulfillable"
            }
          ],
          "match": "ALL",
          "actions": [
            {
              "type": "ADD_INTERNAL_TAG",
              "value": "O"
            }
          ]
        }
      ]
    }
  ],
